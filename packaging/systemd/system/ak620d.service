[Unit]
Description=DeepCool AK620 DIGITAL PRO display daemon
After=dbus.service systemd-udevd.service
Wants=dbus.service

[Service]
Type=simple
User=ak620
Group=ak620
ExecStart=/usr/bin/ak620d
Restart=on-failure
RestartSec=2
StateDirectory=ak620-linux
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
