#!/bin/sh
set -e

case "${1:-}" in
    remove|purge)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable --now ak620d.service || true
            systemctl daemon-reload || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm settle --timeout=10 || true
        fi
        for zone in /sys/class/powercap/*; do
            [ -r "$zone/name" ] && [ -f "$zone/energy_uj" ] || continue
            [ "$(cat "$zone/name")" = package-0 ] || continue
            # Revoke group access before changing ownership. Ignore hot-unplug races.
            chmod 0400 "$zone/energy_uj" || true
            chown root:root "$zone/energy_uj" || true
        done
        # Keep the group and its membership so numeric IDs are never unexpectedly reused.
        ;;
esac

exit 0
